// ---------------- LECTURA: pedir el angulo ----------------
static void Lectura(uint8_t desde_esp)
{
  char resp[N2_BUFFER_SIZE];

  PC_Print("\r\nLectura: solicitando angulo a la Nucleo 2...\r\n");
  if (desde_esp) ESP_Print("Leyendo angulo...\n");

  n2_listo = 0;
  n2_error_linea = 0;

  if (HAL_UART_Transmit(&huart1, (uint8_t *)"R\n", 2, 100) != HAL_OK)
  {
    Aviso_Error(desde_esp, "\r\nERROR: no se pudo enviar R a la Nucleo 2.\r\n",
                "ERROR: no se pudo contactar la Nucleo 2");
  }
  else if (!Esperar_N2(resp, ESPERA_CARGANDO))            // azul girando + musica
  {
    Aviso_Error(desde_esp, "\r\nERROR: la Nucleo 2 no respondio a tiempo.\r\n",
                "ERROR: la Nucleo 2 no respondio");
  }
  else if (strncmp(resp, "D,", 2) == 0)
  {
    char copia[N2_BUFFER_SIZE];
    char *hor = NULL;
    char *rel = NULL;

    if (!Parsear_Dato(resp, copia, &hor, &rel))
    {
      Aviso_Error(desde_esp, "\r\nERROR: formato de medicion inesperado.\r\n",
                  "ERROR: formato de medicion inesperado");
    }
    else
    {
      Neo_SetAll(255, 200, 0);                            // amarillo = transmision

      PC_Print("\r\n===== MEDICION RECIBIDA =====\r\n");
      PC_Print("Inclinacion horizontal: ");
      PC_Print(hor);
      PC_Print(" deg\r\n");
      if (strcmp(rel, "NA") == 0)
      {
        PC_Print("Cambio desde extension: no disponible (falta la referencia Z).\r\n");
      }
      else
      {
        PC_Print("Cambio desde extension: ");
        PC_Print(rel);
        PC_Print(" deg\r\n");
      }

      if (desde_esp)
      {
        ESP_Print("ANGULO: ");
        ESP_Print(hor);
        ESP_Print(" deg | Desde extension: ");
        if (strcmp(rel, "NA") == 0) ESP_Print("no disponible");
        else { ESP_Print(rel); ESP_Print(" deg"); }
        ESP_Print("\n");
      }

      HAL_Delay(TRANSMISION_MS);
    }
  }
  else if (strcmp(resp, "E,CAL") == 0)
  {
    Aviso_Error(desde_esp, "\r\nERROR: calibrar el sensor (C en la Nucleo 2).\r\n",
                "ERROR: falta calibrar el sensor");
  }
  else if (strcmp(resp, "E,REF") == 0)
  {
    Aviso_Error(desde_esp,
                "\r\nERROR: falta establecer la referencia. Coloque la pierna extendida y use la opcion 4 o Z.\r\n",
                "ERROR: falta referencia de extension. Coloca la pierna extendida y solicita REF");
  }
  else if (strcmp(resp, "E,SENSOR") == 0)
  {
    Aviso_Error(desde_esp, "\r\nERROR: la Nucleo 2 no pudo leer el sensor.\r\n",
                "ERROR: no se pudo leer el sensor");
  }
  else
  {
    Aviso_Error(desde_esp, "\r\nERROR: respuesta inesperada de la Nucleo 2.\r\n",
                "ERROR: respuesta inesperada");
  }

  t_reposo = 0;                 // volver al parpadeo de reposo
  reposo_brillo = REPOSO_MIN;
  reposo_dir = 1;
}

