// ---------------- Comandos del ESP32 (celular) ----------------
// READ -> Lectura, SAVE -> Guardado, CAL -> Calibracion, REF/Z -> Referencia
static void Procesar_Comando_ESP(const char *linea)
{
  if (strcmp(linea, "READ") == 0)
  {
    PC_Print("\r\nCelular: comando LECTURA recibido.");
    Lectura(1);
  }
  else if (strcmp(linea, "SAVE") == 0)
  {
    PC_Print("\r\nCelular: comando GUARDADO recibido.");
    Guardado(1);
  }
  else if (strcmp(linea, "CAL") == 0)
  {
    PC_Print("\r\nCelular: comando CALIBRACION recibido.");
    Calibracion(1);
  }
  else if (strcmp(linea, "REF") == 0 || strcmp(linea, "Z") == 0)
  {
    PC_Print("\r\nCelular: comando REFERENCIA recibido.");
    Referencia_Extension(1);
  }
  else
  {
    ESP_Print("ERROR: comando desconocido\n");
    PC_Print("\r\nCelular: comando desconocido: ");
    PC_Print(linea);
    PC_Print("\r\n");
  }

  esp_listo = 0;                
  idx_esp = 0;
  cmd_pc = 0;
  Mostrar_Menu();
}
