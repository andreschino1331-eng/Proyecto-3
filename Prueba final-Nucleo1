// Llena la tabla de un ciclo de seno (12 bits)
static void Sonido_Init(void)
{
  for (int i = 0; i < N_MUESTRAS; i++)
    seno[i] = 2048 + (uint16_t)(1800.0f * sinf(2.0f * 3.14159265f * i / N_MUESTRAS));
}

// Espera 'ms' milisegundos
static void Esperar(uint32_t ms)
{
  uint32_t t0 = HAL_GetTick();
  while ((HAL_GetTick() - t0) < ms)
  {
    if (anim_activa && (HAL_GetTick() - t_anim) >= ANIM_MS)
    {
      t_anim = HAL_GetTick();
      Neo_Girar();
    }
  }
}

// Toca 'freq' Hz durante 'ms' milisegundos (freq = 0 -> silencio)
static void Tono(uint32_t freq, uint32_t ms)
{
  if (freq == 0) { Esperar(ms); return; }

  __HAL_TIM_SET_AUTORELOAD(&htim6, (F_TIMER / (freq * N_MUESTRAS)) - 1);
  __HAL_TIM_SET_COUNTER(&htim6, 0);
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, (uint32_t*)seno, N_MUESTRAS, DAC_ALIGN_12B_R);
  HAL_TIM_Base_Start(&htim6);
  Esperar(ms);
  HAL_TIM_Base_Stop(&htim6);
  HAL_DAC_Stop_DMA(&hdac, DAC_CHANNEL_1);
  Esperar(20);   // pausa corta entre notas
}


// Termina cuando llego la respuesta (y paso el tiempo minimo) o por timeout.
static uint8_t Fin_Espera(uint32_t t_ini)
{
  uint32_t dt = HAL_GetTick() - t_ini;

  if (dt >= N2_TIMEOUT_MS) return 1;
  if ((n2_listo || n2_error_linea) && dt >= CARGA_MIN_MS) return 1;
  return 0;
}

/*
 * Mientras espera la respuesta:
 *   ESPERA_CARGANDO  -> anillo azul girando + musica Mii   (adquisicion)
 *   ESPERA_GUARDANDO -> anillo rojo fijo + Bowser's Castle (almacenamiento SD)
 * Devuelve 1 si llego una linea (copiada en dest), 0 si hubo timeout o error.
 */
static uint8_t Esperar_N2(char *dest, TipoEspera tipo)
{
  const Nota *melodia;
  uint32_t n;
  uint32_t t_ini = HAL_GetTick();

  if (tipo == ESPERA_CARGANDO)
  {
    melodia = mii;
    n = sizeof(mii) / sizeof(mii[0]);
    t_anim = t_ini;
    anim_activa = 1;
  }
  else
  {
    melodia = bowser;
    n = sizeof(bowser) / sizeof(bowser[0]);
    anim_activa = 0;
    Neo_SetAll(255, 0, 0);               // rojo fijo
  }

  while (!Fin_Espera(t_ini))
  {
    for (uint32_t i = 0; i < n && !Fin_Espera(t_ini); i++)
      Tono(melodia[i].freq, melodia[i].ms);
  }
  anim_activa = 0;

  uint8_t ok = 0;
  uint32_t estado_irq = __get_PRIMASK();
  __disable_irq();
  if (n2_listo)
  {
    memcpy(dest, buf_n2, N2_BUFFER_SIZE);
    dest[N2_BUFFER_SIZE - 1] = '\0';
    n2_listo = 0;
    ok = 1;
  }
  n2_error_linea = 0;
  __set_PRIMASK(estado_irq);

  return ok;
}

// Separa "D,horizontal,relativo,deg". Devuelve 1 si el formato es correcto.
static uint8_t Parsear_Dato(const char *linea, char *copia, char **hor, char **rel)
{
  strncpy(copia, linea, N2_BUFFER_SIZE - 1);
  copia[N2_BUFFER_SIZE - 1] = '\0';

  *hor = copia + 2;
  char *r = strchr(*hor, ',');
  if (r == NULL) return 0;
  *r++ = '\0';

  char *u = strchr(r, ',');
  if (u == NULL) return 0;
  *u++ = '\0';

  if (**hor == '\0' || *r == '\0' || strcmp(u, "deg") != 0) return 0;

  *rel = r;
  return 1;
}

