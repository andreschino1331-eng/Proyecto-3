static void Medir_Mostrar_Responder(UART_HandleTypeDef *destino)
{
    if (!calibrado)
    {
        UI_Resultado("Sin calibrar");
        const char error[] = "E,CAL\n";
        HAL_UART_Transmit(destino, (uint8_t *)error, sizeof(error) - 1, 200);
        return;
    }

    UI_Resultado("Midiendo...");
    float angulo;
    if (ADXL_Angulo(&angulo) != HAL_OK)
    {
        /* Conservar la ultima medicion y su estado de guardado. */
        UI_Resultado("Error sensor");
        const char error[] = "E,SENSOR\n";
        HAL_UART_Transmit(destino, (uint8_t *)error, sizeof(error) - 1, 200);
        return;
    }

    /* C fija el cero mediante la calibracion horizontal, sin comando Z. */
    ultimo_angulo = angulo;
    ultima_medicion_valida = 1;
    ultima_medicion_guardada = 0;
    UI_DibujarAngulo();
    UI_Resultado("Lectura OK");

    /* Compatibilidad con Nucleo 1: D,valor1,valor2,deg.
     * Ambos campos contienen el mismo angulo calibrado; no hay extension.
     */
    char respuesta[96];
    snprintf(respuesta, sizeof(respuesta), "D,%.2f,%.2f,deg\n",
              (double)ultimo_angulo, (double)ultimo_angulo);
    HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                      (uint16_t)strlen(respuesta), 200);
}

/* Escribir solamente la instantanea de la ultima R exitosa. */

static void Guardar_Ultima_Medicion(UART_HandleTypeDef *destino)
{
    if (!ultima_medicion_valida)
    {
        UI_Resultado("Sin datos");
        const char respuesta[] = "E,NODATA\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta, sizeof(respuesta) - 1, 200);
        return;
    }

    UI_Resultado("Guardando...");
    char registro[64];
    int longitud = snprintf(registro, sizeof(registro), "%.2f,deg\r\n",
                             (double)ultimo_angulo);
    FRESULT resultado = FR_DISK_ERR;

    if (longitud > 0 && (size_t)longitud < sizeof(registro))
    {
        resultado = f_mount(&fs, "", 1);
        if (resultado == FR_OK)
        {
            FIL archivo;
            resultado = f_open(&archivo, ARCHIVO_ANGULOS, FA_OPEN_APPEND | FA_WRITE);
            if (resultado == FR_OK)
            {
                UINT escritos = 0;
                if (f_size(&archivo) == 0)
                {
                    const char encabezado[] = "angulo_calibrado_deg,unidad\r\n";
                    UINT n = (UINT)(sizeof(encabezado) - 1);
                    resultado = f_write(&archivo, encabezado, n, &escritos);
                    if (resultado == FR_OK && escritos != n)
                        resultado = FR_DISK_ERR;
                }
                if (resultado == FR_OK)
                {
                    resultado = f_write(&archivo, registro, (UINT)longitud, &escritos);
                    if (resultado == FR_OK && escritos != (UINT)longitud)
                        resultado = FR_DISK_ERR;
                }
                FRESULT cierre = f_close(&archivo);
                if (resultado == FR_OK) resultado = cierre;
            }
        }
        FRESULT desmontaje = f_mount(NULL, "", 0);
        if (resultado == FR_OK) resultado = desmontaje;
    }

    const char *respuesta;
    if (resultado == FR_OK)
    {
        ultima_medicion_guardada = 1;
        UI_Resultado("Guardado OK");
        respuesta = "OK,SD\n";
    }
    else
    {
        /* No borrar Guardada si esta medicion ya se guardo antes. */
        UI_Resultado("Error SD");
        respuesta = "E,SD\n";
    }
    HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                      (uint16_t)strlen(respuesta), 200);
}

