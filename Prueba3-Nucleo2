static HAL_StatusTypeDef ADXL_Write(uint8_t reg, uint8_t valor) {

	return HAL_I2C_Mem_Write(&hi2c1, ADXL_ADDR, reg, I2C_MEMADD_SIZE_8BIT, &valor, 1, 100);

}

static HAL_StatusTypeDef ADXL_Init(void) {

	uint8_t id = 0;

	if (HAL_I2C_Mem_Read(&hi2c1, ADXL_ADDR, 0x00, I2C_MEMADD_SIZE_8BIT, &id, 1, 100) != HAL_OK) {

		return HAL_ERROR;

	}

	/* Identidicador del ADXL345 */

	if (id != 0xE5) {

		return HAL_ERROR;

	}

	/* Stanby durante la configuración */

	if (ADXL_Write(0x2D, 0x00) != HAL_OK) {

		return HAL_ERROR;

	}

	/* FULL_RES = 1, rango +/- g, datos justificados a derecha */

	if (ADXL_Write(0x31, 0x08) != HAL_OK) {

		return HAL_ERROR;

	}

    /* Sin correccion adicional en registros de offset */

    if (ADXL_Write(0x1E, 0x00) != HAL_OK)

        return HAL_ERROR;

    if (ADXL_Write(0x1F, 0x00) != HAL_OK)

        return HAL_ERROR;

    if (ADXL_Write(0x20, 0x00) != HAL_OK)

        return HAL_ERROR;

    /* Activar medicion. */

    if (ADXL_Write(0x2D, 0x08) != HAL_OK)

        return HAL_ERROR;

    HAL_Delay(100);

    return HAL_OK;

}

/* Promedia muestras sin aplicar los offsets de software. */

static HAL_StatusTypeDef ADXL_Promedio(float *x, float *y, float *z, uint16_t n) {

	if (n == 0)

        return HAL_ERROR;

    float sx = 0.0f, sy = 0.0f, sz = 0.0f;

    uint8_t datos[6];

    for (uint16_t i = 0; i < n; i++)

    {

        /* A 100 Hz hay una muestra cada 10 ms. Esperamos 12 ms entre lecturas */

        HAL_Delay(12);

        if (HAL_I2C_Mem_Read(&hi2c1, ADXL_ADDR, 0x32, I2C_MEMADD_SIZE_8BIT, datos, 6, 100) != HAL_OK)

            return HAL_ERROR;

        int16_t rx = (int16_t)((uint16_t)datos[0] |

                              ((uint16_t)datos[1] << 8));

        int16_t ry = (int16_t)((uint16_t)datos[2] |

                              ((uint16_t)datos[3] << 8));

        int16_t rz = (int16_t)((uint16_t)datos[4] |

                              ((uint16_t)datos[5] << 8));

        sx += rx;

        sy += ry;

        sz += rz;

    }

    *x = (sx / n) * ADXL_G_PER_LSB;

    *y = (sy / n) * ADXL_G_PER_LSB;

    *z = (sz / n) * ADXL_G_PER_LSB;

    return HAL_OK;

}

/* Calibracion sencilla de offset en una posicion conocida. */

static HAL_StatusTypeDef ADXL_Calibrar(void)

{

    float x, y, z;

    if (ADXL_Promedio(&x, &y, &z, 200) != HAL_OK)

        return HAL_ERROR;

    /* Comprobacion aproximada de la posicion requerida: X e Y horizontales, +Z hacia arriba. No sustituye mantener el sensor inmovil */

    if (fabsf(x) > 0.15f || fabsf(y) > 0.15f || z < 0.80f || z > 1.20f)

        return HAL_ERROR;

    offset_x = x;

    offset_y = y;

    offset_z = z - 1.0f;  /* Conservar la gravedad en Z. */

    calibrado = 1;

    ultima_medicion_valida = 0;
    ultima_medicion_guardada = 0; /* Exigir R con la nueva calibracion. */

    return HAL_OK;

}

static HAL_StatusTypeDef ADXL_Angulo(float *angulo)

{

    float x, y, z;

    if (ADXL_Promedio(&x, &y, &z, 32) != HAL_OK)

        return HAL_ERROR;

    x -= offset_x;

    y -= offset_y;

    z -= offset_z;

    /* Evitar calcular con un vector de gravedad muy pequeño */

    if ((x * x + z * z) < 0.01f)

        return HAL_ERROR;

    *angulo = atan2f(x, z) * RAD_TO_DEG;

    return HAL_OK;

}




/* Borra solamente la franja de valor; conserva los titulos del fondo. */
static void UI_Campo(int x, int ancho, const char *texto)
{
    FillRect(x, UI_ESTADO_Y, ancho, PIXELIFY10_HEIGHT, UI_ESTADO_FONDO);
    int ancho_texto = LCD_TextWidthPixelify10(texto);
    int texto_x = x + (ancho - ancho_texto) / 2;
    LCD_PrintPixelify10(texto, texto_x, UI_ESTADO_Y,
                        UI_ESTADO_COLOR, UI_ESTADO_FONDO);
}

static void UI_ActualizarEstados(void)
{
    UI_Campo(UI_PREP_X, UI_PREP_ANCHO,
              calibrado ? "Lista" : "Sin calibrar");
    const char *estado_medicion = "Sin datos";
    if (ultima_medicion_valida)
        estado_medicion = ultima_medicion_guardada ? "Guardada" : "Sin guardar";
    UI_Campo(UI_MEDICION_X, UI_MEDICION_ANCHO, estado_medicion);
    UI_Campo(UI_RESULTADO_X, UI_RESULTADO_ANCHO, ui_resultado);
}

static void UI_Resultado(const char *texto)
{
    ui_resultado = texto;
    UI_ActualizarEstados();
}

static void UI_DibujarAngulo(void)
{
    char texto[24];
    if (ultima_medicion_valida)
        snprintf(texto, sizeof(texto), "%.1f", (double)ultimo_angulo);
    else
        snprintf(texto, sizeof(texto), "--.-");

    FillRect(ANGULO_X, ANGULO_Y, ANGULO_ANCHO, DIGITAL60_HEIGHT, ANGULO_FONDO);
    int ancho_numero = LCD_TextWidthDigital60(texto);
    int ancho_grado = LCD_TextWidthPixelify40("°");

    if (ancho_numero + 2 + ancho_grado + 1 <= ANGULO_ANCHO)
    {
        LCD_PrintDigital60(texto, ANGULO_X, ANGULO_Y, ANGULO_COLOR, ANGULO_FONDO);
        /* Grados separados en un tamano menor para no invadir la ilustracion. */
        LCD_PrintPixelify40("°", ANGULO_X + ancho_numero + 2, ANGULO_Y,
                            ANGULO_COLOR, ANGULO_FONDO);
    }
    else
    {
        /* Ej.: 120.0 o valores negativos exceden el campo con Digital60. */
        char compacto[28];
        snprintf(compacto, sizeof(compacto), "%s°", texto);
        LCD_PrintPixelify40(compacto, ANGULO_X,
                            ANGULO_Y + (DIGITAL60_HEIGHT - PIXELIFY40_HEIGHT) / 2,
                            ANGULO_COLOR, ANGULO_FONDO);
    }
}

static void Calibrar_Responder(UART_HandleTypeDef *destino)
{
    UI_Resultado("Calibrando...");
    /* Reintentar inicializar si el sensor no respondio al arrancar. */
    if (!sensor_listo)
        sensor_listo = (ADXL_Init() == HAL_OK);

    if (sensor_listo && ADXL_Calibrar() == HAL_OK)
    {
        UI_DibujarAngulo();
        UI_Resultado("Calibración OK");
        const char respuesta[] = "OK,CAL\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta, sizeof(respuesta) - 1, 200);
    }
    else
    {
        /* Un intento fallido no borra una calibracion anterior valida. */
        UI_Resultado("Error calibr.");
        const char respuesta[] = "E,CALFAIL\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta, sizeof(respuesta) - 1, 200);
    }
}

