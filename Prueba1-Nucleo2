&#x20; /\* Infinite loop \*/

&#x20; /\* USER CODE BEGIN WHILE \*/

&#x9;**while** (1) {



&#x9;	/\* Recibir desde la Nucleo de Andres. \*/

&#x9;	    **HAL_StatusTypeDef** recibido =

&#x9;	        **HAL_UART_Receive**(&huart3, &comando, 1, 1);



&#x9;	    **if** (recibido == *HAL_OK*)

&#x9;	    {

&#x9;	        uart_respuesta = &huart3;

&#x9;	    }

&#x9;	    **else**

&#x9;	    {

&#x9;	        /\* Consultar tambien la terminal local de Ana. \*/

&#x9;	        recibido = **HAL_UART_Receive**(&huart2,

&#x9;	                                     &comando,

&#x9;	                                     1,

&#x9;	                                     1\);



&#x9;	        **if** (recibido == *HAL_OK*)

&#x9;	        {

&#x9;	            uart_respuesta = &huart2;

&#x9;	        }

&#x9;	    }



&#x9;	    **if** (recibido == *HAL_OK*)

&#x9;	    {

&#x9;	        /\* Ignorar los caracteres de Enter. \*/

&#x9;	        **if** (comando != '\r' && comando != '\n')

&#x9;	        {

&#x9;	            **if** (comando == '4')

