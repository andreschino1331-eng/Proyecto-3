**static** **HAL_StatusTypeDef** **ADXL_Write**(**uint8_t** reg, **uint8_t** valor) {

&#x9;**return** **HAL_I2C_Mem_Write**(&hi2c1, ADXL_ADDR, reg, I2C_MEMADD_SIZE_8BIT, &valor, 1, 100);

}



**static** **HAL_StatusTypeDef** **ADXL_Init**(**void**) {

&#x9;**uint8_t** id = 0;



&#x9;**if** (**HAL_I2C_Mem_Read**(&hi2c1, ADXL_ADDR, 0x00, I2C_MEMADD_SIZE_8BIT, &id, 1, 100) != *HAL_OK*) {

&#x9;	**return** *HAL_ERROR*;

&#x9;}



&#x9;/\* Identidicador del ADXL345 \*/

&#x9;**if** (id != 0xE5) {

&#x9;	**return** *HAL_ERROR*;

&#x9;}



&#x9;/\* Stanby durante la configuración \*/

&#x9;**if** (**ADXL_Write**(0x2D, 0x00) != *HAL_OK*) {

&#x9;	**return** *HAL_ERROR*;

&#x9;}



&#x9;/\* FULL_RES = 1, rango +/- g, datos justificados a derecha \*/

&#x9;**if** (**ADXL_Write**(0x31, 0x08) != *HAL_OK*) {

&#x9;	**return** *HAL_ERROR*;

&#x9;}



&#x20;   /\* Sin correccion adicional en registros de offset \*/

&#x20;   **if** (**ADXL_Write**(0x1E, 0x00) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;

&#x20;   **if** (**ADXL_Write**(0x1F, 0x00) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;

&#x20;   **if** (**ADXL_Write**(0x20, 0x00) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;



&#x20;   /\* Activar medicion. \*/

&#x20;   **if** (**ADXL_Write**(0x2D, 0x08) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;



&#x20;   **HAL_Delay**(100);

&#x20;   **return** *HAL_OK*;



}



/\* Promedia muestras sin aplicar los offsets de software. \*/

**static** **HAL_StatusTypeDef** **ADXL_Promedio**(**float** \*x, **float** \*y, **float** \*z, **uint16_t** n) {



&#x9;**if** (n == 0)

&#x20;       **return** *HAL_ERROR*;



&#x20;   **float** sx = 0.0f, sy = 0.0f, sz = 0.0f;

&#x20;   **uint8_t** datos[6];



&#x20;   **for** (**uint16_t** i = 0; i < n; i++)

&#x20;   {

&#x20;       /\* A 100 Hz hay una muestra cada 10 ms. Esperamos 12 ms entre lecturas \*/

&#x20;       **HAL_Delay**(12);



&#x20;       **if** (**HAL_I2C_Mem_Read**(&hi2c1, ADXL_ADDR, 0x32, I2C_MEMADD_SIZE_8BIT, datos, 6, 100) != *HAL_OK*)

&#x20;           **return** *HAL_ERROR*;



&#x20;       **int16_t** rx = (**int16_t**)((**uint16_t**)datos[0] |

&#x20;                             ((**uint16_t**)datos[1] << 8));

&#x20;       **int16_t** ry = (**int16_t**)((**uint16_t**)datos[2] |

&#x20;                             ((**uint16_t**)datos[3] << 8));

&#x20;       **int16_t** rz = (**int16_t**)((**uint16_t**)datos[4] |

&#x20;                             ((**uint16_t**)datos[5] << 8));



&#x20;       sx += rx;

&#x20;       sy += ry;

&#x20;       sz += rz;

&#x20;   }



&#x20;   \*x = (sx / n) \* ADXL_G_PER_LSB;

&#x20;   \*y = (sy / n) \* ADXL_G_PER_LSB;

&#x20;   \*z = (sz / n) \* ADXL_G_PER_LSB;



&#x20;   **return** *HAL_OK*;

}



/\* Calibracion sencilla de offset en una posicion conocida. \*/

**static** **HAL_StatusTypeDef** **ADXL_Calibrar**(**void**)

{

&#x20;   **float** x, y, z;



&#x20;   **if** (**ADXL_Promedio**(&x, &y, &z, 200) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;



&#x20;   /\* Comprobacion aproximada de la posicion requerida: X e Y horizontales, +Z hacia arriba. No sustituye mantener el sensor inmovil \*/

&#x20;   **if** (**fabsf**(x) > 0.15f || **fabsf**(y) > 0.15f || z < 0.80f || z > 1.20f)

&#x20;       **return** *HAL_ERROR*;



&#x20;   offset_x = x;

&#x20;   offset_y = y;

&#x20;   offset_z = z - 1.0f;  /\* Conservar la gravedad en Z. \*/



&#x20;   calibrado = 1;

&#x20;   referencia_valida = 0;



&#x20;   **return** *HAL_OK*;

}



**static** **HAL_StatusTypeDef** **ADXL_Angulo**(**float** \*angulo)

{

&#x20;   **float** x, y, z;



&#x20;   **if** (**ADXL_Promedio**(&x, &y, &z, 32) != *HAL_OK*)

&#x20;       **return** *HAL_ERROR*;



&#x20;   x -= offset_x;

&#x20;   y -= offset_y;

&#x20;   z -= offset_z;



&#x20;   /\* Evitar calcular con un vector de gravedad muy pequeño \*/

&#x20;   **if** ((x \* x + z \* z) < 0.01f)

&#x20;       **return** *HAL_ERROR*;



&#x20;   \*angulo = **atan2f**(x, z) \* RAD_TO_DEG;



&#x20;   **return** *HAL_OK*;

}



**static** **float** **Diferencia_Angular**(**float** actual, **float** inicial)

{

&#x20;   **float** diferencia = actual - inicial;



&#x20;   **while** (diferencia > 180.0f)

&#x20;       diferencia -= 360.0f;



&#x20;   **while** (diferencia < -180.0f)

&#x20;       diferencia += 360.0f;



&#x20;   **return** diferencia;

}



