&#x9;		        **if** (**ADXL_Calibrar**() == *HAL_OK*)

&#x9;		            **Serial_Texto**("Calibracion OK.\r\n");

&#x9;		        **else**

&#x9;		            **Serial_Texto**(

&#x9;		                "ERROR: revisar conexion y posicion horizontal +Z.\r\n"

&#x9;		            );

&#x9;		    }





&#x9;		    **else** **if** (comando == 'Z' || comando == 'z')

&#x9;		    {

&#x9;		        **float** angulo;



&#x9;		        **if** (!calibrado)

&#x9;		        {

&#x9;		            **Serial_Texto**("Primero calibrar con C.\r\n");

&#x9;		        }

&#x9;		        **else** **if** (**ADXL_Angulo**(&angulo) == *HAL_OK*)

&#x9;		        {

&#x9;		            referencia = angulo;

&#x9;		            referencia_valida = 1;



&#x9;		            **Serial_Texto**("Referencia de extension guardada.\r\n");

&#x9;		        }

&#x9;		        **else**

&#x9;		        {

&#x9;		            **Serial_Texto**("ERROR de lectura.\r\n");

&#x9;		        }

&#x9;		    }





&#x9;		    **else** **if** (comando == 'R' || comando == 'r')

&#x9;		    {

&#x9;		        **float** angulo;

&#x9;		        **char** texto[120];



&#x9;		        **if** (!calibrado)

&#x9;		        {

&#x9;		            **Serial_Texto**("Primero calibrar con C.\r\n");

&#x9;		        }

&#x9;		        **else** **if** (**ADXL_Angulo**(&angulo) != *HAL_OK*)

&#x9;		        {

&#x9;		            **Serial_Texto**("ERROR de lectura.\r\n");

&#x9;		        }

&#x9;		        **else**

&#x9;		        {

&#x9;			        **char** texto_horizontal[48];

&#x9;			        **char** texto_relativo[48];



&#x9;			        **snprintf**(texto_horizontal, **sizeof**(texto_horizontal), "Horizontal: %.1f deg", (**double**)angulo);



&#x9;			        **if** (referencia_valida) {

&#x9;						**float** relativo = **Diferencia_Angular**(angulo, referencia);



&#x9;						**snprintf**(texto_relativo, **sizeof**(texto_relativo), "Desde extension: %.1f deg", (**double**)relativo);

&#x9;					}



&#x9;			        **else** {

&#x9;						**snprintf**(texto_relativo, **sizeof**(texto_relativo), "Referencia: pendiente");

&#x9;					}



&#x9;			    	**LCD_Print**(texto_horizontal, 0, 94, 1, 0xffff, 0x0000);

&#x9;			    	**LCD_Print**(texto_relativo, 0, 110, 1, 0xffff, 0x0000);



&#x9;		            **if** (referencia_valida)

&#x9;		            {

&#x9;		                **float** relativo =

&#x9;		                    **Diferencia_Angular**(angulo, referencia);



&#x9;		                **snprintf**(texto, **sizeof**(texto),"Horizontal: %.2f deg | " "Cambio desde extension: %.2f deg\r\n", (**double**)angulo, (**double**)relativo);

&#x9;		            }

&#x9;		            **else**

&#x9;		            {

&#x9;		                **snprintf**(texto, **sizeof**(texto), "Horizontal: %.2f deg\r\n", (**double**)angulo);

&#x9;		            }



&#x9;		            **Serial_Texto**(texto);

&#x9;		        }

