int main(void)
{
  HAL_Init();
  SystemClock_Config();

  /* Initialize all configured peripherals (DMA antes que el DAC) */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_DAC_Init();
  MX_TIM3_Init();
  MX_TIM6_Init();
  /* USER CODE BEGIN 2 */
  Sonido_Init();
  Mostrar_Menu();
  /* USER CODE END 2 */

  /* Infinite loop */
  while (1)
  {
    /* USER CODE BEGIN 3 */

    // ---- PC -> Nucleo 1 ----
    if (HAL_UART_Receive(&huart2, &rx_pc, 1, 0) == HAL_OK)
    {
      if (rx_pc == '1')
      {
        HAL_UART_Transmit(&huart1, (uint8_t*)"LED:1\n", 6, 100);
        esperando = 1;
        t_envio = HAL_GetTick();
        PC_Print("\r\nEnviando LED:1 a la Nucleo 2...");
      }
      else if (rx_pc == '2')
      {
        PC_Print("\r\nReproduciendo cancion...");
        Reproducir_Cancion();
        PC_Print("\r\nListo.");
        Mostrar_Menu();
      }
      else if (rx_pc != '\r' && rx_pc != '\n')
      {
        PC_Print("\r\nOpcion invalida.");
        Mostrar_Menu();
      }
    }

    // ---- Nucleo 2 -> Nucleo 1 -> PC ----
    if (HAL_UART_Receive(&huart1, &rx_n2, 1, 0) == HAL_OK)
    {
      if (rx_n2 == '\n')
      {
        buf_n2[idx_n2] = 0;
        idx_n2 = 0;
        esperando = 0;
        PC_Print("\r\nNucleo 2 responde: ");
        PC_Print(buf_n2);
        Mostrar_Menu();
      }
      else if (rx_n2 != '\r' && idx_n2 < 31)
      {
        buf_n2[idx_n2++] = rx_n2;
      }
    }

    // ---- Timeout de la Nucleo 2 ----
    if (esperando && (HAL_GetTick() - t_envio) > TIMEOUT_RESP_MS)
    {
      esperando = 0;
      PC_Print("\r\nERROR: la Nucleo 2 no responde (revisa TX/RX cruzados y GND).");
      Mostrar_Menu();
    }

    __HAL_UART_CLEAR_OREFLAG(&huart1);
    __HAL_UART_CLEAR_OREFLAG(&huart2);
    /* USER CODE END 3 */
  }
}

