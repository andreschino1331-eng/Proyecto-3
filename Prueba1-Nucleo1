/*
 * Melodia aproximada a partir de los acordes de la pagina (se usa la nota
 * raiz de cada acorde). Ajusta frecuencias y duraciones (ms) a tu gusto.
 */
const Nota cancion[] = {
  // --- Intro / estrofa (E D C G B7), dos veces ---
  {MI5,400},{RE5,400},{DO5,400},{SOL4,400},{SI4,600},{SIL,200},
  {MI5,400},{RE5,400},{DO5,400},{SOL4,400},{SI4,600},{SIL,300},

  // --- Puente (C#m B E D C#m B) ---
  {DOs5,400},{SI4,400},{MI5,400},{RE5,400},{DOs5,400},{SI4,600},{SIL,300},

  // --- Coro (G A G A / D G A F# / Bm G C A) ---
  {SOL5,150},{LA5,150},{SOL5,150},{LA5,150},
