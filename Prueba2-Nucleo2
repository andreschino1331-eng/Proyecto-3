// Recepcion por interrupcion: arma una linea hasta '\n'
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART3)
  {
    if (rx3 == '\n')
    {
      buf3[idx3] = 0;
      idx3 = 0;
      linea3 = 1;
    }
    else if (rx3 != '\r' && idx3 < 31)
    {
      buf3[idx3++] = rx3;
    }
    HAL_UART_Receive_IT(&huart3, &rx3, 1);
  }
}

static void Medir_Mostrar_Responder(UART_HandleTypeDef *destino)
{
    float angulo;
    char respuesta[96];

    /* No medir si todavia no existe calibracion. */
    if (!calibrado)
    {
        const char error[] = "E,CAL\n";

        HAL_UART_Transmit(destino,
                          (uint8_t *)error,
                          sizeof(error) - 1,
                          200);
        return;
    }

    /* Hacer una sola adquisicion del sensor. */
    if (ADXL_Angulo(&angulo) != HAL_OK)
    {
        const char error[] = "E,SENSOR\n";

        HAL_UART_Transmit(destino,
                          (uint8_t *)error,
                          sizeof(error) - 1,
                          200);
        return;
    }

    /* Guardar el resultado ahora: S nunca vuelve a leer el ADXL345. */
    ultimo_horizontal = angulo;
    ultima_referencia_valida = referencia_valida;
    ultimo_relativo = referencia_valida
        ? Diferencia_Angular(angulo, referencia) : 0.0f;
    ultima_medicion_valida = 1;

    char texto_horizontal[48];
    char texto_relativo[48];

    snprintf(texto_horizontal,
             sizeof(texto_horizontal),
             "Horizontal: %6.1f deg   ",
             (double)angulo);

    if (referencia_valida)
    {
        float relativo =
            Diferencia_Angular(angulo, referencia);

        snprintf(texto_relativo,
                 sizeof(texto_relativo),
                 "Desde extension: %6.1f deg   ",
                 (double)relativo);

        snprintf(respuesta,
                 sizeof(respuesta),
                 "D,%.2f,%.2f,deg\n",
                 (double)angulo,
                 (double)relativo);
    }
    else
    {
        snprintf(texto_relativo,
                 sizeof(texto_relativo),
                 "Referencia: pendiente          ");

        snprintf(respuesta,
                 sizeof(respuesta),
                 "D,%.2f,NA,deg\n",
                 (double)angulo);
    }

    /* Mostrar la misma medicion en la TFT. */
    LCD_Print(texto_horizontal,
              0, 94, 1, 0xffff, 0x0000);

    LCD_Print(texto_relativo,
              0, 110, 1, 0xffff, 0x0000);

    /* Enviar el resultado al UART solicitado. */
    HAL_UART_Transmit(destino,
                      (uint8_t *)respuesta,
                      (uint16_t)strlen(respuesta),
                      200);
}

/* Escribir solamente la instantanea de la ultima R exitosa. */
static void Guardar_Ultima_Medicion(UART_HandleTypeDef *destino)
{
    const char *respuesta;

    if (!ultima_medicion_valida)
    {
        respuesta = "E,NODATA\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                          (uint16_t)strlen(respuesta), 200);
        return; /* No montar ni crear un archivo sin medicion valida. */
    }

    char registro[96];
    int longitud;

    if (ultima_referencia_valida)
    {
        longitud = snprintf(registro, sizeof(registro),
                            "%.2f,%.2f,deg\r\n",
                            (double)ultimo_horizontal,
                            (double)ultimo_relativo);
    }
    else
    {
        longitud = snprintf(registro, sizeof(registro),
                            "%.2f,NA,deg\r\n",
                            (double)ultimo_horizontal);
    }

    if (longitud < 0 || (size_t)longitud >= sizeof(registro))
    {
        respuesta = "E,SD\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                          (uint16_t)strlen(respuesta), 200);
        return;
    }

    /* Montaje inmediato: comprobar el acceso real a la tarjeta. */
    FRESULT resultado = f_mount(&fs, "", 1);
    if (resultado != FR_OK)
    {
        f_mount(NULL, "", 0);
        respuesta = "E,SD\n";
        HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                          (uint16_t)strlen(respuesta), 200);
        return;
    }

    FIL archivo;
    resultado = f_open(&archivo, "ANGULOS.CSV",
                        FA_OPEN_APPEND | FA_WRITE);

    if (resultado == FR_OK)
    {
        UINT escritos = 0;

        if (f_size(&archivo) == 0)
        {
            const char encabezado[] =
                "horizontal_deg,desde_extension_deg,unidad\r\n";
            UINT n = (UINT)(sizeof(encabezado) - 1);

            resultado = f_write(&archivo, encabezado, n, &escritos);
            if (resultado == FR_OK && escritos != n)
                resultado = FR_DISK_ERR;
        }

        if (resultado == FR_OK)
        {
            resultado = f_write(&archivo, registro,
                                 (UINT)longitud, &escritos);

            /* FR_OK con menos bytes escritos tambien es un error. */
            if (resultado == FR_OK && escritos != (UINT)longitud)
                resultado = FR_DISK_ERR;
        }

        /* Cerrar siempre el archivo abierto y verificar el cierre. */
        FRESULT cierre = f_close(&archivo);
        if (resultado == FR_OK)
            resultado = cierre;
    }

    FRESULT desmontaje = f_mount(NULL, "", 0);
    if (resultado == FR_OK)
        resultado = desmontaje;

    respuesta = (resultado == FR_OK) ? "OK,SD\n" : "E,SD\n";
    HAL_UART_Transmit(destino, (uint8_t *)respuesta,
                      (uint16_t)strlen(respuesta), 200);
}

// Si hay un error de UART (overrun, etc.) se vuelve a armar la recepcion
