/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
//  void transmit_uart(char *string) {
//	  uint8_t len = strlen(string);
//	  HAL_UART_Transmit(&huart2, (uint8_t*) string, len, 200);
//  }

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_USART2_UART_Init();
  MX_I2C1_Init();
  MX_USART3_UART_Init();
  MX_FATFS_Init();
  /* USER CODE BEGIN 2 */

	LCD_Init();

	LCD_Clear(0xffff);

	LCD_Bitmap(0, 0, 320, 240, bg_interfaz);

	uint8_t comando;

	if (ADXL_Init() != HAL_OK) {
		Serial_Texto("ERROR: ADXL345 no detectado/configurado.\r\n");
		/* Sin Error_Handler(): si no, el programa se queda trabado y no
		   atiende los comandos de la Nucleo 1. */
	}

	Serial_Texto(
			"\r\nADXL345 listo.\r\n"
			"C: calibrar horizontal, +Z hacia arriba.\r\n"
			"R: consultar inclinacion.\r\n"
			"S: guardar ultima medicion en ANGULOS.CSV.\r\n"
			"Z: referencia con rodilla extendida.\r\n"
			"4: alternar LED.\r\n");

	/* Recepcion por interrupcion desde la Nucleo 1 (USART3) */
	HAL_UART_Receive_IT(&huart3, &rx3, 1);

	/* La SD se abre y escribe solamente al recibir S. */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {

		/* ---- Comandos de la Nucleo 1 (USART3, por interrupcion) ---- */
		/* ---- Comandos de la Nucleo 1 por USART3 ---- */
		if (linea3)
		{
		    /*
		     * Copiar el comando antes de procesarlo.
		     * La seccion critica es breve: solo copia el buffer.
		     */
		    char comando_n1[sizeof(buf3)];

		    uint32_t estado_irq = __get_PRIMASK();
		    __disable_irq();

		    memcpy(comando_n1, buf3, sizeof(comando_n1));
		    comando_n1[sizeof(comando_n1) - 1] = '\0';
		    linea3 = 0;

		    __set_PRIMASK(estado_irq);

		    if (strcmp(comando_n1, "PING") == 0)
		    {
		        N1_Print("PONG\n");
		    }
		    else if (strcmp(comando_n1, "LED:1") == 0)
		    {
		        HAL_GPIO_WritePin(LD1_GPIO_Port,
		                          LD1_Pin,
		                          GPIO_PIN_SET);

		        led_on = 1;
		        t_led = HAL_GetTick();

		        N1_Print("OK:LED\n");
		    }
		    else if (strcmp(comando_n1, "R") == 0)
		    {
		        Medir_Mostrar_Responder(&huart3);
		    }
			else if (strcmp(comando_n1, "C") == 0)
			{
			    if (ADXL_Calibrar() == HAL_OK)
			        N1_Print("OK,CAL\n");
			    else
			        N1_Print("E,CALFAIL\n");
			}
		    else if (strcmp(comando_n1, "S") == 0)
		    {
		        Guardar_Ultima_Medicion(&huart3);
		    }
		    else
		    {
		        N1_Print("ERR\n");
		    }
		}

		/* ---- Apaga el LED despues de 5 s ---- */
		if (led_on && (HAL_GetTick() - t_led) >= LED_TIEMPO_MS)
		{
			HAL_GPIO_WritePin(LD1_GPIO_Port, LD1_Pin, GPIO_PIN_RESET);
			led_on = 0;
		}

		/* ---- Terminal local (USART2, polling) ---- */
		HAL_StatusTypeDef recibido = HAL_UART_Receive(&huart2, &comando, 1, 1);

		if (recibido == HAL_OK)
		{
			uart_respuesta = &huart2;

			/* Ignorar los caracteres de Enter. */
			if (comando != '\r' && comando != '\n')
			{
				if (comando == '4')
				{
					HAL_GPIO_TogglePin(LD1_GPIO_Port, LD1_Pin);

					uint8_t respuesta[2];

					respuesta[0] =
						(HAL_GPIO_ReadPin(LD1_GPIO_Port, LD1_Pin)
						 == GPIO_PIN_SET) ? '1' : '0';

					respuesta[1] = '\n';

					HAL_UART_Transmit(uart_respuesta,
									  respuesta,
									  sizeof(respuesta),
									  100);
				}

				else if (comando == 'C' || comando == 'c')
				{
					Serial_Texto("Calibrando: mantener inmovil...\r\n");

					if (ADXL_Calibrar() == HAL_OK)
						Serial_Texto("Calibracion OK.\r\n");
					else
						Serial_Texto(
							"ERROR: revisar conexion y posicion horizontal +Z.\r\n"
						);
				}

				else if (comando == 'Z' || comando == 'z')
				{
					float angulo;

					if (!calibrado)
					{
						Serial_Texto("Primero calibrar con C.\r\n");
					}
					else if (ADXL_Angulo(&angulo) == HAL_OK)
					{
						referencia = angulo;
						referencia_valida = 1;
						ultima_medicion_valida = 0; /* Exigir una nueva R. */

						Serial_Texto("Referencia de extension guardada.\r\n");
					}
					else
					{
						Serial_Texto("ERROR de lectura.\r\n");
					}
				}

				else if (comando == 'S' || comando == 's')
				{
				    Guardar_Ultima_Medicion(&huart2);
				}
				else if (comando == 'R' || comando == 'r')
				{
				    Medir_Mostrar_Responder(&huart2);
				}
			}
		}
	}

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  /* USER CODE END 3 */
}

