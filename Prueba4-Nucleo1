/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_DAC_Init();
  MX_TIM6_Init();
  MX_TIM1_Init();
  MX_USART6_UART_Init();
  /* USER CODE BEGIN 2 */
  Sonido_Init();
  Neo_SetAll(0, 255, 0);      // verde = sistema en espera

  HAL_UART_Receive_IT(&huart2, &rx_pc, 1);
  HAL_UART_Receive_IT(&huart1, &rx_n2, 1);
  HAL_UART_Receive_IT(&huart6, &rx_esp, 1);

  Mostrar_Menu();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

    // ---- Comando de la PC ----
    if (cmd_pc)
    {
      uint8_t c = cmd_pc;
      cmd_pc = 0;

      if (lectura_pendiente)
      {
        PC_Print("\r\nEspere la respuesta del sensor antes de otra opcion.\r\n");
      }
      else if (c == '1')
      {
        Modo1();
        cmd_pc = 0;          // ignora teclas pulsadas durante la cancion
        Mostrar_Menu();
      }
      else if (c == '2')
      {
        Modo2();
        cmd_pc = 0;
        Mostrar_Menu();
      }
      else if (c == '3' || c == 'R' || c == 'r')
      {
        Solicitar_Angulo();
      }
      else if (c == '4')
      {
        HAL_UART_Transmit(&huart1, (uint8_t*)"LED:1\n", 6, 100);
        PC_Print("\r\nLED:1 enviado a la Nucleo 2...");
      }
      else
      {
        PC_Print("\r\nOpcion invalida.");
        Mostrar_Menu();
      }
    }

    // ---- Comando recibido del ESP32 (celular por Bluetooth) ----
    if (esp_listo)
    {
      char comando_esp[ESP_BUFFER_SIZE];
      uint32_t estado_esp = __get_PRIMASK();
      __disable_irq();
      memcpy(comando_esp, buf_esp, sizeof(comando_esp));
      comando_esp[sizeof(comando_esp) - 1] = '\0';
      esp_listo = 0;
      __set_PRIMASK(estado_esp);

      Procesar_Comando_ESP(comando_esp);
    }

    // ---- Copiar y procesar la respuesta fuera de la interrupcion ----
    char respuesta_n2[N2_BUFFER_SIZE];
    uint8_t hay_respuesta = 0;
    uint8_t error_linea;
    uint32_t estado_irq = __get_PRIMASK();
    __disable_irq();

    if (n2_listo)
    {
      memcpy(respuesta_n2, buf_n2, sizeof(respuesta_n2));
      respuesta_n2[sizeof(respuesta_n2) - 1] = '\0';
      n2_listo = 0;
      hay_respuesta = 1;
    }
    error_linea = n2_error_linea;
    n2_error_linea = 0;

    __set_PRIMASK(estado_irq);

    if (hay_respuesta)
    {
      Procesar_Respuesta_N2(respuesta_n2);
      Mostrar_Menu();
    }

    if (error_linea)
    {
      lectura_pendiente = 0;
      PC_Print("\r\nERROR: linea UART demasiado larga o respuesta pendiente sin procesar. Repita la solicitud.\r\n");
      Mostrar_Menu();
    }

    if (lectura_pendiente &&
        (HAL_GetTick() - t_lectura) >= N2_TIMEOUT_MS)
    {
      lectura_pendiente = 0;
      PC_Print("\r\nERROR: Nucleo 2 no envio la medicion en 5 segundos.\r\n");
      Mostrar_Menu();
    }
  }
  /* USER CODE END 3 */
}

