// ---------------- Adquisicion del angulo por USART1 ----------------
static void Solicitar_Angulo(void)
{
  const char solicitud[] = "R\n";

  // Mostrar antes de transmitir para que main atienda la respuesta enseguida.
  PC_Print("\r\nSolicitando angulo a la Nucleo 2...\r\n");
  lectura_pendiente = 1;
  t_lectura = HAL_GetTick();

  if (HAL_UART_Transmit(&huart1, (uint8_t *)solicitud,
                        sizeof(solicitud) - 1, 100) != HAL_OK)
  {
    lectura_pendiente = 0;
    PC_Print("\r\nERROR: no se pudo enviar R a la Nucleo 2.\r\n");
    Mostrar_Menu();
  }
}

static void Procesar_Respuesta_N2(const char *linea)
{
  // Formato esperado: D,horizontal,relativo,deg
  // relativo = NA si Ana no ha establecido la referencia con Z.
  if (strncmp(linea, "D,", 2) == 0)
  {
    char copia[N2_BUFFER_SIZE];
    strncpy(copia, linea, sizeof(copia) - 1);
    copia[sizeof(copia) - 1] = '\0';

    char *horizontal = copia + 2;
    char *relativo = strchr(horizontal, ',');
    char *unidad = NULL;

    if (relativo != NULL)
    {
      *relativo++ = '\0';
      unidad = strchr(relativo, ',');
      if (unidad != NULL) *unidad++ = '\0';
    }

    lectura_pendiente = 0;
    if (relativo == NULL || unidad == NULL ||
        *horizontal == '\0' || *relativo == '\0' ||
        strcmp(unidad, "deg") != 0)
    {
      PC_Print("\r\nERROR: formato de medicion inesperado. Recibido: ");
      PC_Print(linea);
      PC_Print("\r\n");
      return;
    }

    // Los campos ya llegan como texto: no se necesita scanf/printf con float.
    PC_Print("\r\n===== MEDICION RECIBIDA =====\r\n");
    PC_Print("Inclinacion horizontal: ");
    PC_Print(horizontal);
    PC_Print(" deg\r\n");

    if (strcmp(relativo, "NA") == 0)
    {
      PC_Print("Cambio desde extension: no disponible. Ejecutar Z en la terminal de Ana.\r\n");
    }
    else
    {
      PC_Print("Cambio desde extension: ");
      PC_Print(relativo);
      PC_Print(" deg\r\n");
    }
  }
  else if (strcmp(linea, "E,CAL") == 0)
  {
    lectura_pendiente = 0;
    PC_Print("\r\nERROR: calibrar el sensor con C en la terminal de Ana.\r\n");
  }
  else if (strcmp(linea, "E,SENSOR") == 0)
  {
    lectura_pendiente = 0;
    PC_Print("\r\nERROR: Nucleo 2 no pudo adquirir el angulo del sensor.\r\n");
  }
  else
  {
    // Conservar la presentacion de respuestas de LED y otras pruebas.
    if (strcmp(linea, "ERR") == 0) lectura_pendiente = 0;
    PC_Print("\r\nNucleo 2 responde: ");
    PC_Print(linea);
    PC_Print("\r\n");
  }
}

// ---------------- Comandos del ESP32 (celular) ----------------
// READ  -> pide el angulo a la Nucleo 2 (igual que la opcion 3 del menu)
// MODO1 -> cancion + NeoPixel rojo (igual que la opcion 1)
// MODO2 -> cargando: anillo girando + musica (igual que la opcion 2)
static void Procesar_Comando_ESP(const char *linea)
{
  if (strcmp(linea, "READ") == 0)
  {
    if (lectura_pendiente)
    {
      ESP_Print("BUSY\n");
      PC_Print("\r\nCelular: solicitud ignorada, ya hay una lectura en curso.\r\n");
    }
    else
    {
      ESP_Print("ACK:READ\n");
      PC_Print("\r\nCelular: comando LECTURA recibido.");
      Solicitar_Angulo();
    }
  }
  else if (strcmp(linea, "MODO1") == 0)
  {
    ESP_Print("ACK:MODO1\n");
    PC_Print("\r\nCelular: comando MODO 1 recibido.");
    Modo1();
    ESP_Print("DONE:MODO1\n");
    esp_listo = 0;           // ignora comandos repetidos durante la cancion
    idx_esp = 0;
    cmd_pc = 0;
    Mostrar_Menu();
  }
  else if (strcmp(linea, "MODO2") == 0)
  {
    ESP_Print("ACK:MODO2\n");
    PC_Print("\r\nCelular: comando MODO 2 recibido.");
    Modo2();
    ESP_Print("DONE:MODO2\n");
    esp_listo = 0;
    idx_esp = 0;
    cmd_pc = 0;
    Mostrar_Menu();
  }
  else
  {
    ESP_Print("ERR\n");
    PC_Print("\r\nCelular: comando desconocido: ");
    PC_Print(linea);
    PC_Print("\r\n");
    Mostrar_Menu();
  }
}

// ---------------- UART por interrupcion ----------------
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART2)            // PC
  {
    if (rx_pc != '\r' && rx_pc != '\n') cmd_pc = rx_pc;
    HAL_UART_Receive_IT(&huart2, &rx_pc, 1);
  }
  else if (huart->Instance == USART1)       // Nucleo 2
  {
    if (rx_n2 == '\n')
    {
      if (rx_n2_desbordando)
      {
        // Descartar la linea completa; no publicar un angulo truncado.
        n2_error_linea = 1;
      }
      else if (idx_n2 > 0)
      {
        if (!n2_listo)
        {
          memcpy(buf_n2, rx_linea_n2, idx_n2);
          buf_n2[idx_n2] = '\0';
          n2_listo = 1;
        }
        else
        {
          n2_error_linea = 1;
        }
      }
      idx_n2 = 0;
      rx_n2_desbordando = 0;
    }
    else if (rx_n2 != '\r')
    {
      if (idx_n2 < sizeof(rx_linea_n2) - 1)
        rx_linea_n2[idx_n2++] = (char)rx_n2;
      else
        rx_n2_desbordando = 1;
    }
    HAL_UART_Receive_IT(&huart1, &rx_n2, 1);
  }
  else if (huart->Instance == USART6)       // ESP32
  {
    if (rx_esp == '\n')
    {
      if (idx_esp > 0 && !esp_listo)
      {
        memcpy(buf_esp, rx_linea_esp, idx_esp);
        buf_esp[idx_esp] = '\0';
        esp_listo = 1;
      }
      idx_esp = 0;
    }
    else if (rx_esp != '\r')
    {
      if (idx_esp < sizeof(rx_linea_esp) - 1)
        rx_linea_esp[idx_esp++] = (char)rx_esp;
      else
        idx_esp = 0;                        // linea demasiado larga: se descarta
    }
    HAL_UART_Receive_IT(&huart6, &rx_esp, 1);
  }
}

// Si hay un error de UART (overrun, etc.) se vuelve a armar la recepcion
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART2) HAL_UART_Receive_IT(&huart2, &rx_pc, 1);
  if (huart->Instance == USART1)
  {
    idx_n2 = 0;
    rx_n2_desbordando = 0;
    n2_error_linea = 1;
    HAL_UART_Receive_IT(&huart1, &rx_n2, 1);
  }
  if (huart->Instance == USART6)
  {
    idx_esp = 0;
    HAL_UART_Receive_IT(&huart6, &rx_esp, 1);
  }
}

// ---------------- NeoPixel ----------------
// Envia al anillo el contenido de led_rgb (orden de envio GRB)
static void Neo_Show(void)
{
  uint32_t idx = 0;

  for (int led = 0; led < NUM_LEDS; led++)
  {
    uint32_t color = ((uint32_t)led_rgb[led][1] << 16)   // G
                   | ((uint32_t)led_rgb[led][0] << 8)    // R
                   |  (uint32_t)led_rgb[led][2];         // B
    for (int bit = 23; bit >= 0; bit--)
      neo_buf[idx++] = ((color >> bit) & 1) ? NEO_T1 : NEO_T0;
  }

  for (int i = 0; i < NEO_RESET; i++) neo_buf[idx++] = 0;

  neo_busy = 1;
  HAL_TIM_PWM_Start_DMA(&htim1, TIM_CHANNEL_1, (uint32_t*)neo_buf, idx);

  uint32_t t0 = HAL_GetTick();
  while (neo_busy && (HAL_GetTick() - t0) < 20);   // espera con timeout
}

// Todos los LED del mismo color
static void Neo_SetAll(uint8_t r, uint8_t g, uint8_t b)
{
  for (int led = 0; led < NUM_LEDS; led++)
  {
    led_rgb[led][0] = r / NEO_BRILLO;
    led_rgb[led][1] = g / NEO_BRILLO;
    led_rgb[led][2] = b / NEO_BRILLO;
  }
  Neo_Show();
}

// Un paso de la animacion "cargando": una luz azul con estela que avanza
static void Neo_Girar(void)
{
  static uint8_t pos = 0;

  memset(led_rgb, 0, sizeof(led_rgb));
  for (int t = 0; t < COLA; t++)
  {
    int led = (pos - t + NUM_LEDS) % NUM_LEDS;
    uint16_t f = 255 >> t;                                       // 255,127,63,31,15,7
    led_rgb[led][0] = 0;                                         // R
    led_rgb[led][1] = (uint8_t)(150 * f / 255 / NEO_BRILLO);     // G
    led_rgb[led][2] = (uint8_t)(f / NEO_BRILLO);                 // B
  }
  Neo_Show();

  pos = (pos + 1) % NUM_LEDS;
}

// Se llama al terminar de enviar el buffer por DMA
void HAL_TIM_PWM_PulseFinishedCallback(TIM_HandleTypeDef *htim)
{
  if (htim->Instance == TIM1)
  {
    HAL_TIM_PWM_Stop_DMA(htim, TIM_CHANNEL_1);
    neo_busy = 0;
  }
}

// ---------------- Audio ----------------
// Llena la tabla de un ciclo de seno (12 bits)
static void Sonido_Init(void)
{
  for (int i = 0; i < N_MUESTRAS; i++)
    seno[i] = 2048 + (uint16_t)(1800.0f * sinf(2.0f * 3.14159265f * i / N_MUESTRAS));
}

// Espera 'ms' milisegundos; si anim_activa = 1, mueve el anillo mientras tanto
static void Esperar(uint32_t ms)
{
  uint32_t t0 = HAL_GetTick();
  while ((HAL_GetTick() - t0) < ms)
  {
    if (anim_activa && (HAL_GetTick() - t_anim) >= ANIM_MS)
    {
      t_anim = HAL_GetTick();
      Neo_Girar();
    }
  }
}

// Toca 'freq' Hz durante 'ms' milisegundos (freq = 0 -> silencio)
static void Tono(uint32_t freq, uint32_t ms)
{
  if (freq == 0) { Esperar(ms); return; }

  __HAL_TIM_SET_AUTORELOAD(&htim6, (F_TIMER / (freq * N_MUESTRAS)) - 1);
  __HAL_TIM_SET_COUNTER(&htim6, 0);
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1, (uint32_t*)seno, N_MUESTRAS, DAC_ALIGN_12B_R);
  HAL_TIM_Base_Start(&htim6);
  Esperar(ms);
  HAL_TIM_Base_Stop(&htim6);
  HAL_DAC_Stop_DMA(&hdac, DAC_CHANNEL_1);
  Esperar(20);   // pausa corta entre notas
}

// Reproduce una tabla de notas 'repeticiones' veces
static void Reproducir(const Nota *c, uint32_t n, int repeticiones)
{
  for (int r = 0; r < repeticiones; r++)
    for (uint32_t i = 0; i < n; i++)
      Tono(c[i].freq, c[i].ms);
}

// ---------------- Modo 1 ----------------
// NeoPixel en rojo mientras suena la cancion; al terminar vuelve a verde (espera)
static void Modo1(void)
{
  PC_Print("\r\nModo 1: reproduciendo cancion...");
  Neo_SetAll(255, 0, 0);       // rojo
  Reproducir(bowser, sizeof(bowser) / sizeof(bowser[0]), 4);
  Neo_SetAll(0, 255, 0);       // verde = en espera
  PC_Print("\r\nListo.");
}

// ---------------- Modo 2 ----------------
// "Cargando": el anillo gira mientras suena la melodia; al terminar vuelve a verde
static void Modo2(void)
{
  PC_Print("\r\nModo 2: Cargando...");
  t_anim = HAL_GetTick();
  anim_activa = 1;
  Reproducir(mii, sizeof(mii) / sizeof(mii[0]), 1);
  anim_activa = 0;
  Neo_SetAll(0, 255, 0);       // verde = en espera
  PC_Print("\r\nListo.");
}
